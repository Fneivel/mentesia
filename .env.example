# Copie este arquivo para ".env" e troque os valores.

# Chave secreta das sessões: gere uma com  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Login do painel /admin
ADMIN_USER=fabiano
ADMIN_PASSWORD=troque-esta-senha

# Pasta onde ficam o banco de dados e os arquivos enviados (em produção, aponte para o disco persistente)
DATA_DIR=./data

# Em produção (HTTPS), deixe 1 para proteger o cookie de login
PRODUCTION=0

# Tamanho máximo de upload, em MB
MAX_UPLOAD_MB=25
